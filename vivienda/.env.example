# URL pública (para metadatos, sitemap, OpenGraph y enlaces en calendario)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL (Supabase o cualquier Postgres ≥ 14). Sin esta variable la app lee
# los ficheros de /data (curados + snapshots del ETL) y los envíos ciudadanos se desactivan en producción.
# DATABASE_URL=postgres://user:pass@localhost:5432/vivienda

# Token para /moderacion (cabecera Authorization: Bearer ... o cookie tras login).
MODERATION_TOKEN=cambia-esto

# Secreto HMAC para el sello temporal anti-spam de formularios y el hash diario de IP.
SUBMISSION_SECRET=cambia-esto-tambien

# Teselas vectoriales opcionales (esquema OpenMapTiles) para calles al hacer zoom.
# Por defecto OpenFreeMap. Déjalo vacío para usar solo la cartografía propia (IGN vía es-atlas).
NEXT_PUBLIC_VECTOR_TILES=https://tiles.openfreemap.org/planet

# ETL: base PxWeb del CGPJ (la ruta cambia con cada versión publicada; ver DATA_SOURCES.md)
# CGPJ_PXWEB_BASE=https://www6.poderjudicial.es/PxWeb-20252-v1
