{
  "name": "mapa-por-la-vivienda",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-vendor.mjs",
    "predev": "node scripts/copy-vendor.mjs",
    "prebuild": "node scripts/copy-vendor.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx tests/e2e/setup-fixtures.ts && VIVIENDA_DATA_DIR=tests/fixtures/data next build && VIVIENDA_DATA_DIR=tests/fixtures/data playwright test",
    "geo:build": "tsx scripts/build-geo.ts",
    "ingest:cgpj": "tsx scripts/ingest.ts cgpj",
    "ingest:cgpj:discover": "tsx scripts/ingest.ts cgpj --discover",
    "ingest:ine": "tsx scripts/ingest.ts ine",
    "ingest:manual": "tsx scripts/ingest.ts manual",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:sync": "tsx scripts/db-sync.ts",
    "privacy:degrade": "tsx scripts/privacy-degrade.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "maplibre-gl": "^6.11.2",
    "next": "^16.3.6",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-simplify": "^3.0.3",
    "@types/topojson-specification": "^1.0.5",
    "es-atlas": "^0.6.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "world-atlas": "^2.0.2"
  }
}
